{
  "name": "@toon-protocol/swap",
  "version": "3.0.0",
  "description": "TOON Protocol swap client — relay-mediated rolling swaps between payment-channel claims (EVM/Solana)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "toon-swap": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "import": "./dist/wallet.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [
    "toon",
    "nostr",
    "ilp",
    "swap",
    "payment-channel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toon-protocol/swap.git",
    "directory": "packages/swap"
  },
  "author": "ALLiDoizCode",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@scure/bip32": "^2.0.0",
    "@scure/bip39": "^2.0.0",
    "@solana/web3.js": "^1.98.4",
    "@toon-protocol/client": "^2.1.0",
    "@toon-protocol/core": "^3.5.0",
    "@toon-protocol/sdk": "^3.3.0",
    "@toon-protocol/settlement-digest": "^1.1.0",
    "ed25519-hd-key": "^1.3.0",
    "nostr-tools": "^2.20.0",
    "viem": "^2.0.0",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "mina-signer": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "mina-signer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@toon-protocol/relay": "^2.0.2",
    "@toon-protocol/shared": "^1.3.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
